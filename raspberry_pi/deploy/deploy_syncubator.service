[Unit]
Description=Syncubator Flask Backend
After=network.target

[Service]
Type=simple
# Change to whichever user should run the service; must have access to
# GPIO/I2C/camera (typically via membership in the gpio, i2c, video groups).
User=machhr
WorkingDirectory=/home/machhr/syncubator_app
ExecStart=/home/machhr/syncubator_app/venv/bin/gunicorn --workers 1 --worker-class gthread --threads 8 --timeout 0 --bind 127.0.0.1:5000 app:app
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
